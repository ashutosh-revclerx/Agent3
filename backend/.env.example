# Backend environment variables

# Required core keys
GEMINI_API_KEY=your_gemini_api_key_here
NEXUS_API_KEY=your_nexus_api_key_here

# Optional integrations
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here
LIVEAVATAR_AVATAR_ID=your_liveavatar_avatar_id_here
# LITE mode only for this app.
# Context/voice settings are not used for the LITE session bootstrap path.
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_VIDEO_QUALITY=high
LIVEAVATAR_VIDEO_ENCODING=VP8
# Optional: BYO LiveKit for LITE mode (when both are set, sent as livekit_config).
# LIVEAVATAR_CUSTOM_LIVEKIT_URL=wss://your-livekit-server.com
# LIVEAVATAR_CUSTOM_LIVEKIT_TOKEN=your_livekit_agent_token
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database
DB_USER=copilot_user
DB_PASSWORD=copilot_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot_db

# CORS / deployment
FRONTEND_URL=http://localhost:5173

# Runtime defaults
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis Cache
REDIS_URL=redis://localhost:6379/0
