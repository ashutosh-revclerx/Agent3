# Backend environment variables

# Required core keys
GEMINI_API_KEY=your_gemini_api_key_here
NEXUS_API_KEY=your_nexus_api_key_here

# Optional integrations
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here
LIVEAVATAR_AVATAR_ID=your_liveavatar_avatar_id_here
LIVEAVATAR_CONTEXT_ID=your_liveavatar_context_id_here
LIVEAVATAR_VOICE_ID=your_liveavatar_voice_id_here
LIVEAVATAR_LANGUAGE=en
LIVEAVATAR_SANDBOX=true
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database
DB_USER=copilot_user
DB_PASSWORD=copilot_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot_db

# CORS / deployment
FRONTEND_URL=http://localhost:5173

# Runtime defaults
HOST=0.0.0.0
PORT=8000
DEBUG=false
